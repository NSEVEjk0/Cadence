# Optional: the default binds to loopback so a TLS proxy can publish the app.
CADENCE_HOST=127.0.0.1
CADENCE_PORT=45300
# Keys are entered in the app and held only for the active connection.
# Do not put a Presage key into a VITE_ variable or into tracked source.
# For the optional private hosted room, point to a secret file outside the repo:
# CADENCE_CREDENTIALS_FILE=/absolute/path/to/private-secrets.env
