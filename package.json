{
  "name": "cadence-rehearsal",
  "version": "0.1.0",
  "private": true,
  "description": "A camera-aware rehearsal teleprompter powered by Presage SmartSpectra.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts server/worker.ts --bundle --platform=node --packages=external --format=esm --outdir=server-dist --out-extension:.js=.mjs",
    "start": "node server-dist/index.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "sdk:check": "node --import tsx scripts/check-sdk.ts",
    "demo:record": "node scripts/record-walkthrough.mjs"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.5.0",
    "express": "5.3.0",
    "lucide-react": "1.74.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
